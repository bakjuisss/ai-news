# Vercel Environment Variables (Settings → Environment Variables)

GEMINI_API_KEY=your_gemini_api_key

# 이메일 전송 — Brevo 권장 (네이버·Outlook 등 모든 수신자에게 발송 가능)
# 1. https://www.brevo.com 가입
# 2. Senders → 발신 이메일 추가 후 인증 링크 클릭
# 3. SMTP & API → API Keys에서 키 발급
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_FROM_EMAIL=your-verified-email@example.com
BREVO_FROM_NAME=AI 뉴스

# (선택) Resend — 도메인 미인증 시 가입 이메일로만 전송 가능
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL=AI 뉴스 <noreply@yourdomain.com>
