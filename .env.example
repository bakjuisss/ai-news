# Vercel Environment Variables (Settings → Environment Variables)

GEMINI_API_KEY=your_gemini_api_key

# 이메일 전송 — Nodemailer + SMTP (오픈소스, 외부 API 불필요)
# SMTP_PRESET: naver | outlook | gmail | custom

# 네이버 메일 예시
# 1. 네이버 메일 → 환경설정 → POP3/IMAP → 사용함
# 2. 네이버 보안설정 → 2단계 인증 → 애플리케이션 비밀번호 생성
SMTP_PRESET=naver
SMTP_USER=your-id@naver.com
SMTP_PASS=your_naver_app_password
SMTP_FROM_NAME=AI 뉴스

# Outlook 예시
# SMTP_PRESET=outlook
# SMTP_USER=your-id@outlook.com
# SMTP_PASS=your_outlook_app_password

# Gmail 예시
# SMTP_PRESET=gmail
# SMTP_USER=your-id@gmail.com
# SMTP_PASS=your_gmail_app_password

# 직접 SMTP 서버 지정 (SMTP_PRESET=custom)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
